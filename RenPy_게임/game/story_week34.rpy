# Workdays 11–20. Non-graphic relationship drama and neutral production gaps.
default w34_started = False
default w34_finished = False
default w34_route = None
default w34_visit = "rest"
default w34_answer = "pending"
default w34_private = []
default w34_seen_gaps = []
default w34_outfit = None
default w34_gap_page = 0
default w34_gap_token = None

init 47 python:
    w34_codes = {"seoyun":"SY", "ria":"RI", "yujin":"YJ", "jihyun":"JH"}
    w34_core_flags = {"seoyun":"sy_shared_load", "ria":"ri_credit_given", "yujin":"yj_reason_heard", "jihyun":"jh_review_transferred"}
    def w34_eligible(who):
        p = people[who]
        return p["affection"] >= 40 and p["trust"] >= 45 and p["episode_stage"] >= 3 and p["core_resolved"] and flags.get(w34_core_flags[who],False) and not p["breach"]
    def w34_missing(who):
        p = people[who]
        missing = []
        if p["affection"] < 40: missing.append("호감 %d/40" % p["affection"])
        if p["trust"] < 45: missing.append("신뢰 %d/45" % p["trust"])
        if p["episode_stage"] < 3 or not p["core_resolved"] or not flags.get(w34_core_flags[who]): missing.append("개인 핵심 사건")
        if p["breach"]: missing.append("미해결 약속")
        return " / ".join(missing) or "선택 가능"
    def w34_set_route(who):
        if who != "team" and not w34_eligible(who):
            raise ValueError("Route prerequisites not met")
        store.w34_route = who
        store.w34_answer = "pending"
        store.route_intent = who
    def w34_resolve_core(who):
        flags[w34_core_flags[who]] = True
        people[who]["core_resolved"] = True
        complete_week_event(w34_codes[who]+"03",who,{"affection":10,"trust":12},stage=3)
    def w34_relation(answer):
        who = w34_route
        if who not in names: raise ValueError("No individual route")
        if answer == "dating" and not w34_eligible(who): raise ValueError("Relationship prerequisites not met")
        if who == "jihyun" and answer == "dating" and not flags.get("jh_review_transferred"): raise ValueError("Review authority still held")
        store.w34_answer = answer
        people[who]["relationship"] = "dating" if answer == "dating" else "none"
        complete_week_event(w34_codes[who]+"04",who,{"trust":4},stage=4)
        # Relationship confirmation does not grant photo permissions or gap consent.
    def w34_can_gap():
        return w34_route in names and w34_answer == "dating" and people[w34_route]["relationship"] == "dating" and not people[w34_route]["breach"]
    def w34_record_gap(token):
        if not w34_can_gap(): raise ValueError("No agreed relationship")
        if token not in w34_seen_gaps: w34_seen_gaps.append(token)
    def w34_clear_outfit():
        if w34_outfit in names: ui_pose_set(w34_outfit,None)
        store.w34_outfit = None
        ui_camera_set(None)
    def w34_show_outfit(who,kind):
        w34_clear_outfit()
        store.w34_outfit = who
        ui_pose_set(who,kind)
    for _who in names:
        if _who == "ria":
            # Previous Ria outfit artwork was removed; use the approved MASTER.
            ui_pose_files[_who].update({kind:"images/characters/ria_master.png" for kind in ("daily_a","daily_b","date_a","date_b")})
        else:
            ui_pose_files[_who].update({kind:"images/characters/%s_outfits/%s.png" % (_who,kind) for kind in ("daily_a","daily_b","date_a","date_b")})
    for _d,_who,_text in [(12,"ria","메시지가 삭제되었습니다. 만나서 이야기할게요."),(15,"seoyun","오늘은 식사만 하고 각자 돌아가요. 개인적인 약속은 다음에 시간을 확인하고요."),(17,"yujin","퇴근 뒤에는 다른 곳에서 이야기할 수 있어요. 회사 자료는 놓고 와 주세요.")]:
        message_data["w34_%d" % _d] = {"who":_who,"time":"17:50","texts":[_text]}

screen w34_placeholder(token, page=1, total=1):
    modal True
    zorder 250
    add Solid("#000000")
    button:
        background None
        xfill True yfill True
        action Return(True)
        null
    button:
        action Return(True)
        background ui_panel("glass")
        xpos 80 ypos 850 xsize 1760 ysize 220 padding (36,20)
        vbox:
            spacing 8
            text ("AFTER HOURS / %d / %d" % (page,total) if total > 1 else "AFTER HOURS") size 20 color "#9CACB4" kerning 2
            text "(거사중)" id "what" size 31 color "#F8F4EE"
    add Solid("#D6B18A") xpos 116 ypos 850 xsize 72 ysize 3
    use quick_menu
    key "dismiss" action Return(True)
    if renpy.is_skipping():
        timer 0.1 action Return(True)
    elif preferences.afm_enable:
        timer 3.0 action Return(True)

label week34_start:
    $ w34_started = True
    jump week34_workday

label week34_workday:
    $ w34_clear_outfit()
    $ week_scene("meeting","모멘트웍스 / 회의실","09:00","morning","같은 편이라는 말" if day < 16 else "약속이 되는 마음")
    call expression "w34_morning_%d" % day
    if day == 15:
        menu:
            "체험과 예약을 나누고 추가 인력 조건을 함께 제안한다.":
                $ flags["c03_scope"] = "split"
                dh "행사 체험과 자세한 안내를 나누겠습니다. 인력을 확보하지 못하면 체험 인원을 제한합니다."
            "현 규모를 지키고 다음 공개 일정으로 확대를 제안한다.":
                $ flags["c03_scope"] = "bounded"
                dh "지금 확인한 규모는 지키겠습니다. 추가 요청은 별도의 일정과 인력으로 제안합니다."
        $ complete_week_event("C03",effects={"project":10,"team_trust":5})
        python:
            for _who in names:
                complete_week_event("w34_c03_"+_who,_who,{"affection":2,"trust":4})
    elif day == 20:
        $ complete_week_event("C04",effects={"project":10,"team_trust":5})
    call w34_lunch
    if 11 <= day <= 14:
        $ w34_core_who = ("seoyun","ria","yujin","jihyun")[day-11]
        call expression "w34_core_"+w34_core_who
    if day in (12,15,17):
        $ clock = "17:50"
        $ send_message("w34_%d" % day)
    if day == 15:
        call w34_group_dinner
        call w34_choose_route
    elif day >= 16:
        call w34_route_evening
    else:
        call w34_unsettled_evening
    $ w34_clear_outfit()
    if day == 20:
        $ w34_finished = True
    call week_close_day
    if _return != "continue":
        return
    if day == 20:
        jump week56_start
    $ start_week_day(day+1,"같은 편이라는 말" if day < 15 else "약속이 되는 마음")
    jump week34_workday

label w34_lunch:
    $ week_scene("lounge","모멘트웍스 / 라운지","12:30","lunch","점심에 남긴 말")
    menu:
        "서윤과 점심을 먹는다.":
            $ w34_visit = "seoyun"
        "리아와 점심을 먹는다.":
            $ w34_visit = "ria"
        "유진과 점심을 먹는다.":
            $ w34_visit = "yujin"
        "지현과 점심을 먹는다.":
            $ w34_visit = "jihyun"
        "혼자 쉬며 오늘의 생각을 정리한다.":
            $ w34_visit = "rest"
    if w34_visit == "rest":
        "혼자 앉아 오늘 들은 말을 정리했다. 누군가에게 답하기 전에 내 생각을 먼저 알아야 했다."
        dh "상대가 듣고 싶은 답과 제가 할 수 있는 답을 같은 것으로 적지는 말자."
        "좋아하는 사람에게 다른 의견을 말한 순간과 말하지 못한 순간을 나눠 보았다."
        "내일은 같은 질문에 조금 더 정확히 답할 수 있을 것 같았다."
    else:
        call expression "w34_lunch_"+w34_visit
        $ complete_week_event("w34_lunch_%d_%s" % (day,w34_visit),w34_visit,{"affection":3,"trust":4})
        if day >= 16 and w34_route in names and w34_visit != w34_route:
            "점심 약속을 다른 뜻으로 남기지 않았다. 동료와의 대화도 이어질 수 있었다."
    return

label w34_group_dinner:
    $ week_scene("restaurant","회사 근처 / 식당","18:30","evening","금요일의 식사")
    sy "제 이름을 안 넣고도 끝나는 칸이 생겼네요. 오늘은 그걸 축하하고 싶어요."
    ri "저는 제 이름을 넣어서 좋아요. 발표 자료 맨 앞에요."
    yj "같은 방법이 모두에게 필요한 건 아니었네요."
    jh "도현 씨도 이번에는 확인하지 않은 약속을 하지 않았습니다."
    dh "아직 불편한 말은 느리게 나오지만, 오늘은 금요일 전에 꺼냈네요."
    "술을 마시는 동료는 귀가 방법부터 정했다. 나는 식사만 하고 물을 마셨다."
    ri "오늘 개인적인 대답까지 회식 자리에서 받지는 않을게요. 다른 사람 앞이면 웃어넘기게 될 수도 있으니까."
    sy "다음 약속은 둘이 시간을 확인해서 잡아요. 단체 일정에 넣지 말고요."
    yj "좋아요. 오늘은 먹고 싶은 메뉴나 하나 더 고르죠."
    jh "업무 연락은 여기서 닫겠습니다. 내일 다시 접속할 일은 없어요."
    "각자 자기 몫을 정산하고 귀가했다. 술자리의 분위기로 사적인 관계를 결정하지 않았다."
    return

label w34_choose_route:
    $ week_scene("home","도현의 집","21:00","evening","내가 말할 마음")
    "같이 보낸 시간과 실제로 확인한 약속을 떠올렸다. 방향을 골랐다고 교제가 자동으로 시작되는 것은 아니었다."
    python:
        for _who in names:
            renpy.say(None,names[_who]+" — "+w34_missing(_who))
    "여러 관계를 함께 논의하는 경로는 여섯 협업 사건이 아직 구현되지 않아 이번 버전에서 열리지 않는다."
    menu:
        "서윤에게 개인적인 마음을 말한다." if w34_eligible("seoyun"):
            $ w34_set_route("seoyun")
        "리아에게 개인적인 마음을 말한다." if w34_eligible("ria"):
            $ w34_set_route("ria")
        "유진에게 개인적인 마음을 말한다." if w34_eligible("yujin"):
            $ w34_set_route("yujin")
        "지현에게 개인적인 마음을 말한다." if w34_eligible("jihyun"):
            $ w34_set_route("jihyun")
        "이번에는 팀과 내 일상에 집중한다.":
            $ w34_set_route("team")
    "아직 다른 사람에게 하지 않은 약속은 만들지 않았다. 선택하지 않은 동료의 일과 인사도 계속 이어진다."
    return

label w34_unsettled_evening:
    $ week_scene("rooftop","회사 밖 / 밤 산책","19:10","evening","아직 말하지 않은 답")
    "점심에 한 말과 오후의 대답을 떠올리며 걸었다. 하나는 업무 약속이었고 다른 하나는 개인적인 질문이었다."
    dh "같이 있고 싶은 마음까지 담당자 칸에 적을 수는 없겠지."
    "누구에게나 좋은 사람이라는 답으로 넘기면, 누군가에게는 기다리라는 약속처럼 들릴 수도 있었다."
    "오늘 못 한 말은 없던 것으로 지우지 않고 다음에 꺼낼 질문으로 남겨 두었다."
    dh "금요일에는 제가 실제로 원하는 방향을 말해야겠다."
    "혼자 보내는 저녁에도 다른 사람에게 맞춰 정하지 않은 시간이 있었다."
    return

label w34_route_evening:
    if w34_route not in names:
        $ week_scene("home","도현의 집","19:30","evening","회사 밖의 나")
        call expression "w34_team_%d" % (day-16)
        return
    $ week_scene("cafe" if w34_route in ("seoyun","ria") else "rooftop","회사 밖 / 약속한 자리","19:30","evening","둘이 정하는 시간")
    $ w34_show_outfit(w34_route,"daily_a" if day == 16 else ("daily_b" if day == 19 else ("date_b" if day in (18,20) else "date_a")))
    "퇴근 뒤 각자 집에 들러 옷을 갈아입고 다시 만났다. 회사에서 하던 이야기와는 다른 약속이었다."
    call expression "w34_evening_%s_%d" % (w34_route,day-16)
    if day == 17:
        call w34_unexpected_meeting
    if day == 18:
        menu:
            "연인으로 만나고 싶다고 답한다.":
                $ w34_relation("dating")
                dh "저도 같은 마음입니다. 앞으로의 약속은 둘이 정하고 싶어요."
            "좋아하지만 관계를 정하는 데 시간이 더 필요하다고 말한다.":
                $ w34_relation("defer")
                dh "제 마음을 더 생각해 보고 싶습니다. 기다리라는 약속을 요구하지는 않을게요."
            "친구와 동료로 이어가고 싶다고 솔직히 말한다.":
                $ w34_relation("friends")
                dh "제가 할 수 없는 약속을 하고 싶지는 않습니다. 친구와 동료로 계속 만나고 싶어요."
        if w34_can_gap():
            menu:
                "서로 원하는지 확인하고 오늘은 시간을 더 함께 보낸다.":
                    dh "저는 오늘 더 함께 있고 싶습니다. 지금 같은 마음인지 다시 듣고 싶어요."
                    call expression "w34_gap_"+w34_route
                "오늘은 돌아가고 다음 만남을 잡는다.":
                    call w34_slow_evening
        else:
            call w34_slow_evening
    elif day == 19:
        if w34_seen_gaps:
            "함께 보낸 시간을 없던 일로 하지 않았다. 다음 약속은 어제의 답을 당연하게 여기지 않고 다시 물었다."
        elif w34_answer in ("defer","friends"):
            "같은 자리에 앉아도 대답을 다시 요구하지 않았다. 어제 말한 속도를 유지하고 다른 이야기로 시간을 채웠다."
            call w34_slow_evening
    elif day == 20:
        if w34_can_gap():
            menu:
                "오늘도 서로의 뜻을 확인하고 함께 시간을 보낸다.":
                    call w34_gap_followup
                "이번 주는 여기까지 하고 다음 약속을 잡는다.":
                    call w34_slow_evening
        else:
            call w34_slow_evening
    $ complete_week_event("w34_evening_%d_%s" % (day,w34_route),w34_route,{"affection":2,"trust":2})
    $ w34_clear_outfit()
    return

label w34_slow_evening:
    "오늘의 답을 바꾸도록 설득하는 대신 조금 더 이야기했다."
    dh "지난번에 추천해 주신 것, 제가 다르게 느낀 부분이 있어요."
    "좋았던 부분과 어색했던 부분을 모두 말할 수 있었다. 같은 감상이 되어야 다음에 만나는 것은 아니었다."
    dh "오늘은 돌아가고 싶습니다. 다음에는 가능한 시간을 먼저 말씀드릴게요."
    "귀가할 길을 같이 확인했다. 혼자 남긴 대답도 다음 만남에서 기억할 수 있었다."
    "방금 고른 속도를 벌점이나 실패로 남기지 않았다. 다음 대화에 가져갈 이야기가 더 생겼다."
    return

label w34_morning_11:
