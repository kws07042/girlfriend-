# Workdays 21–30: consequences, repair and individual/team endings.
default w56_started = False
default w56_finished = False
default w56_focus = None
default w56_old_breach = {}
default w56_breaks = []
default w56_sent = []
default w56_commitment = "unasked"
default w56_final_choice = None
default w56_ending_id = None
default w56_ending_kind = None
default w56_final_gap = False
default persistent.office_endings = []

init 48 python:
    def w56_begin():
        if not w56_started:
            store.w56_focus = w34_route if w34_route in names else "team"
            store.w56_old_breach = {who:people[who]["breach"] for who in names}
            store.w56_started = True
    def w56_person_event(token,effects):
        if w56_focus in names: complete_week_event(token,w56_focus,effects)
    def w56_break(token):
        if w56_focus not in names or token in completed_events: return
        w56_breaks.append(token)
        people[w56_focus]["breach"] = True
        if people[w56_focus]["relationship"] == "dating":
            people[w56_focus]["relationship"] = "paused"
            store.w34_answer = "paused"
        w56_person_event(token,{"trust":-6})
    def w56_repair():
        if w56_focus not in names: return
        store.w56_breaks = []
        people[w56_focus]["breach"] = w56_old_breach.get(w56_focus,False)
        w56_person_event("w56_repair",{"trust":4})
        # Repair alone never resumes dating or clears a pre-existing breach.
    def w56_resume():
        if w56_focus not in names or people[w56_focus]["breach"]: raise ValueError("Unresolved agreement")
        w34_relation("dating")
        store.w56_commitment = "together"
    def w56_pause():
        store.w56_commitment = "apart"
        if w56_focus in names:
            people[w56_focus]["relationship"] = "paused" if people[w56_focus]["relationship"] == "dating" else "none"
            store.w34_answer = "paused" if people[w56_focus]["relationship"] == "paused" else w34_answer
    def w56_ending():
        if w56_focus not in names: return "team"
        p=people[w56_focus]
        continuing=w56_final_choice == "continue" and w56_commitment != "apart" and w34_answer != "friends"
        core=p["core_resolved"] and flags.get(w34_core_flags[w56_focus],False)
        if w56_focus == "jihyun": core=core and flags.get("jh_review_transferred",False)
        if continuing and core and not p["breach"] and p["relationship"] == "dating" and p["episode_stage"] >= 4 and w34_codes[w56_focus]+"04" in completed_events and p["affection"] >= 70 and p["trust"] >= 65 and stats["project"] >= 70:
            return "good"
        if continuing and core and not p["breach"] and p["affection"] >= 50 and p["trust"] >= 45:
            return "open"
        return "distance"
    def w56_can_final_gap():
        return w56_ending_kind == "good" and w34_can_gap() and w56_commitment != "apart"
    def w56_unlock_ending():
        store.w56_ending_kind=w56_ending()
        store.w56_ending_id=(w56_focus+"_"+w56_ending_kind) if w56_focus in names else "team"
        if w56_ending_id not in persistent.office_endings:
            persistent.office_endings.append(w56_ending_id)
            renpy.save_persistent()
    def w56_work_good():
        complete_week_event("w56_work_%d" % day,effects={"project":3,"planning":1})
        flags["w56_quality_%d" % day]="checked"
    def w56_message(token,text,time,out=False):
        if w56_focus not in names or token in w56_sent: return
        w56_sent.append(token)
        if phone_time_minutes(time) > phone_time_minutes(clock):
            store.clock = time
        phone_messages.append({"who":w56_focus,"out":out,"text":text,"time":time,"day":day,"id":token})
        if not out: phone_unread[w56_focus] = phone_unread.get(w56_focus,0)+1
    def w56_evening_gain():
        if w56_focus in names:
            reward={"trust":1}
            if people[w56_focus]["relationship"] == "dating" and not people[w56_focus]["breach"]: reward["affection"]=1
            w56_person_event("w56_evening_%d" % day,reward)

screen w56_endcard():
    modal True
    zorder 250
    add Solid("#101820")
    frame:
        background ui_panel("incoming")
        align (0.5,0.5) xsize 1120 padding (48,40)
        vbox:
            spacing 24
            text "AFTER HOURS / DAY 30" size 24 color "#916641"
            text (names[w56_focus]+" / "+{"good":"다음에도, 우리","open":"아직 남은 이야기","distance":"각자의 시간"}[w56_ending_kind] if w56_focus in names else "우리의 다음 일상") size 48
            text ("런칭 결과: 정식 공개" if stats["project"] >= 70 else ("런칭 결과: 범위를 줄여 공개" if stats["project"] >= 50 else "런칭 결과: 공개 전 재정비")) size 27
            text "함께 보낸 여섯 주를 마쳤습니다." size 27
            text "엔딩 기록은 보관됩니다. 복수 관계 경로는 아직 제작 중입니다." size 23 color "#68777B"
            hbox:
                spacing 18
                textbutton "저장" action ShowMenu("save") style "ui_action_button"
                textbutton "제목으로" action Return("title") style "ui_light_button"

label week56_start:
    $ w56_begin()
    $ start_week_day(21,"미뤄지는 시간")
    jump week56_workday

label week56_workday:
    $ w34_clear_outfit()
    $ week_scene("meeting","모멘트웍스 / 회의실","09:00","morning","미뤄지는 시간" if day < 26 else "퇴근 후, 우리")
    call expression "w56_morning_%d" % day
    if day in (22,24,27,29):
        call w56_work_choice
    if day == 25:
        $ complete_week_event("C05",effects={"project":10,"team_trust":5})
    elif day == 30:
        $ complete_week_event("C06",effects={"project":10,"team_trust":5})
    call w56_lunch
    if day == 30:
        call w56_finish
        return
    call w56_evening
    $ w34_clear_outfit()
    call week_close_day
    if _return != "continue":
        return
    $ start_week_day(day+1,"미뤄지는 시간" if day < 25 else "퇴근 후, 우리")
    jump week56_workday

label w56_work_choice:
    menu:
        "확인한 근거와 가능한 범위를 적고 수정한다.":
            $ w56_work_good()
            dh "확인한 파일과 실제로 시험한 범위부터 전달하겠습니다. 모르는 부분은 확인 중으로 남기죠."
            "시간을 들여 검토한 항목이 다음 작업의 기준으로 남았다."
        "추가 확인 없이 지금 추측한 안으로 진행한다.":
            $ flags["w56_quality_%d" % day] = "unverified"
            dh "지금 예상한 범위로 먼저 가겠습니다. 아직 확인하지 않은 질문은 남아 있습니다."
            "속도를 선택했지만 검증까지 끝난 것으로 적지는 않았다. 런칭에서 공개할 범위가 달라질 수 있었다."
    return

label w56_lunch:
    $ week_scene("lounge","모멘트웍스 / 라운지","12:30","lunch","업무가 아닌 대답")
    call expression "w56_lunch_%d" % (day-21)
    return

label w56_evening:
    if w56_focus not in names:
        $ week_scene("home","도현의 집","19:30","evening","회사 밖의 다음 시간")
        call expression "w56_team_%d" % (day-21)
        return
    if day == 22:
        $ week_scene("office","모멘트웍스 / 오픈 오피스","16:30","afternoon","약속 시간 전에")
        call w56_promise_choice
    elif day == 24:
        $ week_scene("lounge","모멘트웍스 / 라운지","17:20","afternoon","같이 있던 시간")
        call w56_disclosure_choice
    $ week_scene("restaurant" if day in (21,22,25) else "rooftop","회사 밖 / 약속한 자리","19:30","evening","미루지 않고 듣는 말")
    $ w34_show_outfit(w56_focus,("daily_a","date_a","daily_b","date_b")[(day-21)%4])
    $ ui_camera_set("C" if day in (22,24,26,29) else "B")
    call expression "w56_private_%s_%d" % (w56_focus,day-21)
    if day == 22:
        if flags.get("w56_promise") == "early":
            "미리 연락을 받은 상대는 다른 시간을 고를 수 있었다. 아쉬운 마음까지 사라지는 것은 아니었지만 기다리도록 버려두지는 않았다."
        else:
            "약속한 시간에 아무 답을 받지 못한 사람의 이야기를 들었다. 이유를 설명하는 것만으로 기다린 시간이 돌아오지는 않았다."
    elif day == 24:
        if flags.get("w56_disclosure") == "protect":
            "당사자가 정하지 않은 이야기를 먼저 공개하지 않았다. 둘이 있었던 시간을 없었다고 말하지도 않았다."
        else:
            "업무 밖의 약속은 없었다는 내 말이 남았다. 비공개로 두는 것과 있었던 시간을 부정하는 것은 다른 일이었다."
    elif day == 26:
        call w56_reconcile_choice
    elif day == 29:
        call w56_final_direction
    $ w56_evening_gain()
    $ w34_clear_outfit()
    return

label w56_promise_choice:
    "오늘 늦어질 수 있다는 걸 미리 알았다. 상대가 기다리기 전에 연락할지, 일이 끝난 뒤 설명할지 고를 수 있었다."
    menu:
        "지금 연락하고 만날 시간을 함께 바꾼다.":
            $ flags["w56_promise"] = "early"
            $ w56_message("w56_early_out","오늘 늦어질 수 있어요. 약속 시간을 같이 바꿔도 될까요?","16:30",out=True)
            $ w56_message("w56_early_in","미리 알려 줘서 고마워요. 19시 30분에 짧게 이야기해요.","16:31")
            $ w56_person_event("w56_early_contact",{"trust":3})
            dh "오늘 늦어질 수 있어요. 지금 알려 드리고 다른 시간을 함께 고르고 싶습니다."
        "일이 끝날 때까지 연락을 미루고 뒤늦게 설명한다.":
            $ flags["w56_promise"] = "late"
            $ week_scene("evening","모멘트웍스 / 늦은 퇴근","19:20","evening","늦게 보낸 답")
            $ w56_message("w56_late_out","늦어질 수 있다는 걸 알고도 먼저 말하지 못했어요.","19:20",out=True)
            $ w56_message("w56_late_in","약속 시간을 이미 지났어요. 오늘은 19시 30분에 잠깐만 이야기하고 돌아갈게요.","19:21")
            $ w56_break("w56_late_contact")
            "일을 끝낸 뒤에야 휴대폰을 열었다. 약속한 시간을 이미 지나 있었다."
            dh "늦어질 수 있다는 걸 알고도 먼저 말하지 못했습니다."
    return

label w56_disclosure_choice:
    "다른 사람의 질문에 답하기 전에 당사자와 정한 범위를 떠올렸다. 민망한 질문을 피하려고 사실까지 바꿀지 고를 수 있었다."
    menu:
        "개인적인 약속이 있었다고만 말하고 자세한 내용은 공개하지 않는다.":
            $ flags["w56_disclosure"] = "protect"
            $ w56_person_event("w56_private_boundary",{"trust":3})
            dh "따로 잡은 약속이 있었어요. 자세한 이야기는 저희가 같이 정해서 말하겠습니다."
        "업무 밖의 약속은 없었다고 부정한다.":
            $ flags["w56_disclosure"] = "deny"
            $ w56_break("w56_denied_meeting")
            dh "업무 밖에서 따로 만난 약속은 없었습니다."
            "민망한 질문은 짧게 끝났지만 함께 있었던 사람에게 설명할 말이 남았다."
    return

label w56_reconcile_choice:
    if w56_breaks:
        "미루거나 부정했던 말을 직접 꺼낼 차례였다. 일이 잘됐다는 결과로 개인적인 답을 대신할 수는 없었다."
    else:
        "이번 주에 지킨 약속을 다음 주에도 지킬 수 있는지 물었다. 오해를 일부러 만들어 다시 풀 필요는 없었다."
    menu:
        "미룬 말까지 솔직히 꺼내고 다음 약속을 함께 정한다.":
            $ w56_repair()
            dh "제가 실제로 한 말과 하지 못한 답을 말씀드리겠습니다. 다음에는 가능한 시간을 먼저 알려 드릴게요."
            if people[w56_focus]["relationship"] == "dating" and not people[w56_focus]["breach"]:
                $ w56_commitment = "together"
                "상대도 같은 마음으로 관계를 이어가고 싶다고 답했다. 새로운 약속은 가능한 시간을 확인해서 잡았다."
            elif w34_answer == "paused" and w34_eligible(w56_focus):
                menu:
                    "서로 뜻을 확인하고 관계를 다시 이어간다.":
                        "상대도 다시 관계를 이어가고 싶다고 말했다. 사과한 사실만으로 답을 대신하지 않았다."
                        $ w56_resume()
                    "지금은 거리를 두고 생각할 시간을 남긴다.":
                        $ w56_pause()
                        "오늘 사과를 들었다고 오늘 다시 같은 관계가 되어야 하는 것은 아니었다."
            else:
                $ w56_commitment = "learning"
                "친구나 더 알아보는 관계를 교제로 바꾸지 않았다. 다음 만남의 속도를 그대로 확인했다."
        "답을 더 미루고 지금은 거리를 두겠다고 말한다.":
            $ w56_pause()
            dh "지금 같은 약속을 할 수는 없습니다. 기다리라는 말로 붙잡지는 않겠습니다."
            "거리를 두겠다는 답도 상대에게 직접 말하고 돌아갔다."
    return

label w56_final_direction:
    "프로젝트가 끝난 뒤 어떤 관계로 다시 만나고 싶은지 직접 답했다. 좋은 점수나 마지막 날의 분위기가 답을 대신하지는 않았다."
    menu:
        "프로젝트가 끝나도 개인적으로 계속 만나고 싶다고 말한다.":
            $ w56_final_choice = "continue"
            dh "일이 끝나도 다시 만나고 싶습니다. 제가 가능한 시간으로 다음 약속을 잡고 싶어요."
        "친구와 동료로 남고 개인적인 관계는 여기까지라고 말한다.":
            $ w56_final_choice = "distance"
            $ w56_pause()
            dh "개인적인 관계는 여기까지로 생각하고 있습니다. 다른 답을 기다리게 하지는 않을게요."
    return

label w56_finish:
    $ w34_clear_outfit()
    $ week_scene("evening","모멘트웍스 / 마지막 퇴근","18:30","evening","회의가 없는 다음 약속")
    if stats["project"] >= 70:
        "확인한 범위로 정식 공개를 마쳤다. 기록한 질문은 다음 버전의 자료로 남았다."
    elif stats["project"] >= 50:
        "행사는 확인한 기능 위주로 규모를 줄여 공개했다. 아직 시험하지 않은 약속을 현장에서 추가하지 않았다."
    else:
        "공개 전 다시 정비할 항목이 남았다. 팀은 검증하지 못한 기능을 성공한 것처럼 발표하지 않았다."
    $ w56_unlock_ending()
    if w56_focus in names:
        $ week_scene("cafe" if w56_focus in ("seoyun","ria") else "rooftop","회사 밖 / 마지막 저녁","19:30","evening","퇴근 후, 우리")
        $ w34_show_outfit(w56_focus,"date_b" if w56_ending_kind == "good" else "daily_b")
        if w34_answer == "friends":
            call expression "w56_end_friend_"+w56_focus
        else:
            call expression "w56_end_%s_%s" % (w56_focus,w56_ending_kind)
        if w56_can_final_gap():
            menu:
                "서로의 뜻을 확인하고 프로젝트 이후의 시간을 함께 보낸다.":
                    "상대도 지금 함께 있고 싶다고 답했다. 다음 만남의 대답까지 먼저 정하지는 않았다."
                    $ w34_clear_outfit()
                    $ ui_scene_actor = None
                    $ ui_pose_transitions = {}
                    call w34_gap_sequence(w56_focus+"_final",5)
                    $ w34_record_gap(w56_focus+"_final")
                    $ w56_final_gap = True
                    $ week_scene("home","도현의 집","21:30","evening","다음에도 이어질 시간")
                    "다음 약속은 공유 폴더나 회의 일정 없이 잡았다. 여섯 주 뒤에도 서로 시간을 내고 싶은 마음으로 연락하기로 했다."
                "오늘은 돌아가고 다음 약속을 남긴다.":
                    "다음 약속을 함께 정하고 각자의 길로 돌아갔다. 오늘 함께 시간을 더 보내지 않아도 같은 관계는 이어질 수 있었다."
    else:
        call w56_end_team
    $ w34_clear_outfit()
    $ week_scene("home","도현의 집","22:00","evening","여섯 주의 기록")
    $ w56_finished = True
    call screen w56_endcard
    return

label w56_morning_21:
    "다섯 번째 월요일 아침, 고객 메일 제목에 긴급이라는 말이 두 번 들어 있었다."
    jh "이번 주는 리허설입니다. 새 요구를 바로 확정해서 답하지 않겠습니다."
    ri "행사장에서 발표할 사람이 바뀔 수 있대요. 제 자료를 다른 사람에게 넘기라는 뜻인지 먼저 묻고 싶어요."
    sy "문의 응답을 하나로 합치면 지금까지 나눈 담당자 칸이 다시 제 쪽으로 돌아와요."
    yj "화면을 새로 그리는 것보다 무엇을 바꾸려는 건지 먼저 듣죠."
    dh "저는 모두 가능하다고 답하지 않았습니다. 확인할 범위를 적어서 보냈어요."
    jh "좋아요. 사적인 약속이 있다는 이유로 거짓 일정을 쓰지도 맙시다. 가능하지 않은 시간을 먼저 밝히면 됩니다."
    "금요일에 잡은 다음 만남이 달력에 있었다. 업무 마감 옆에 있다고 쉽게 옮길 수 있는 약속은 아니었다."
    sy "제가 오래 기다릴 수 있어 보인다고 마지막에 연락하지는 말아 주세요."
