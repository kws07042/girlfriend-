# Workdays 6–10: tentative interest follows actual conversations, never auto-switches.
default focus_interest = None
default focus_days = {who:[] for who in ("seoyun","ria","yujin","jihyun")}
default focus_open = {who:False for who in ("seoyun","ria","yujin","jihyun")}
default focus_history = []
default focus_review_seen = {who:0 for who in ("seoyun","ria","yujin","jihyun")}
default focus_locked = False
default route_intent = None
default week2_finished = False

init 46 python:
    def focus_eligible(who):
        return who in names and len(focus_days.get(who,[])) >= 2 and focus_open.get(who,False) and people[who]["trust"] >= 15
    def focus_candidates():
        if focus_locked:
            return []
        return [who for who in names if who != focus_interest and focus_eligible(who)]
    def focus_review_candidates():
        return [who for who in focus_candidates() if len(focus_days[who]) > focus_review_seen.get(who,0)]
    def focus_start(who):
        if who is not None and who not in names:
            raise ValueError("Unknown interest")
        if focus_history:
            return
        store.focus_interest = who
        focus_history.append({"day":day,"from":None,"to":who,"reason":"first_week"})
    def focus_record(who,topic,opened=False):
        if who not in names or not 6 <= day <= 10:
            return
        token = "w2:%d:%s" % (day,who)
        if token not in completed_events:
            complete_week_event(token,who,{"affection":3,"trust":2})
        if day not in focus_days[who]:
            focus_days[who].append(day)
        if opened:
            focus_open[who] = True
        flags["w2_topic_%d_%s" % (day,who)] = topic
    def focus_switch(who):
        if who not in focus_candidates():
            raise ValueError("A change requires shared conversations and trust")
        old = focus_interest
        if old in names:
            focus_review_seen[old] = len(focus_days[old])
        store.focus_interest = who
        focus_history.append({"day":day,"from":old,"to":who,"reason":"shared_time"})
    def focus_confirm(who):
        if who != "team" and not focus_eligible(who):
            raise ValueError("Cannot confirm an unfamiliar direction")
        store.route_intent = who
        store.focus_interest = None if who == "team" else who
        store.focus_locked = True
        # Direction is not dating, event completion, or adult-photo consent.

