# Additive first-day branches. Existing Ria lunch/cafe labels remain intact.
init 40 python:
    d1_lunch_openings = {
        "seoyun": ["점심 전에 한숨 돌리셨나요? 저는 라운지에서 메뉴 보는 중이에요.","같이 드실 거면 옆자리 비워 둘게요. 첫날이라 길 찾는 것도 일이죠."],
        "yujin": ["이제 자료는 닫았어요. 라운지 안쪽에 자리가 있네요.","같이 드실래요? 점심엔 시안 말고 다른 이야기도 해요."],
        "jihyun": ["라운지로 가는 길이에요. 점심은 같이 먹어도 괜찮습니다.","업무 보고를 준비할 필요는 없어요. 자리만 확인해 주세요."]}
    d1_evening_openings = {
        "seoyun": ["오늘 차를 다 식혀 버렸네요. 퇴근길 카페에서 한 잔 마시려고요.","잠깐 같이 쉬실래요? 지금 통화 괜찮으시면 자리 이야기만 할게요."],
        "yujin": ["회사 앞 카페에서 조금 쉬고 있어요. 창가 말고 안쪽 자리예요.","제가 자주 걷는 골목 지도를 보고 있는데, 시간 괜찮으시면 같이 볼래요?"],
        "jihyun": ["먼저 퇴근하셨나요? 저는 회사 앞 카페에 잠깐 앉아 있어요.","일 때문은 아니에요. 오늘 못 끝낸 이야기가 있어서, 잠깐 통화 괜찮으실까요?"]}
    d1_night_texts = {
        "seoyun": ["오늘은 차를 따뜻할 때 마셨어요. 이야기해 주셔서 고마웠어요.","책 제목은 다음에 알려 드릴게요. 결말은 제가 먼저 읽고요."],
        "yujin": ["아까 지도에 표시한 가게 이름을 메모해 뒀어요.","오늘은 자료 말고도 이야기할 게 있었네요. 다음에 또 이어가요."],
        "jihyun": ["오늘은 카페에서 시계를 덜 봤네요.","약속처럼 정할 필요는 없지만, 다음에도 업무 밖 이야기 조금 해요."]}
    for _d1_who in ("seoyun","yujin","jihyun"):
        key = "d1_"+_d1_who+"_lunch"
        message_data[key] = {"who":_d1_who,"time":"12:20","texts":d1_lunch_openings[_d1_who],"reply":[
            {"text":"좋아요. 같이 먹으면서 이야기해요.","response":"네. 자리에서 기다릴게요. 천천히 오세요.","plan":"talk"},
            {"text":"오늘은 잠깐 쉬고 싶어요. 오후에 이야기해요.","response":"좋아요. 점심은 편히 쉬세요. 오후에 뵐게요.","plan":"rest"}]}
        phone_reply_deadlines[key] = "12:30"
        message_data["d1_"+_d1_who+"_evening"] = {"who":_d1_who,"time":"18:55","texts":d1_evening_openings[_d1_who]}
        key = "d1_"+_d1_who+"_night"
        message_data[key] = {"who":_d1_who,"time":"21:10","texts":d1_night_texts[_d1_who],"reply":[
            {"text":"오늘 이야기 좋았어요. 다음에도 이어서 이야기해요.","response":"저도 좋았어요. 편히 쉬시고 내일 봐요."},
            {"text":"첫날 챙겨 주셔서 고마웠어요. 내일 뵐게요.","response":"네. 오늘 수고하셨어요. 내일 회사에서 봐요."}]}
        phone_late_replies[key] = [
            {"text":"그날 이야기 기억에 남았어요. 다음에도 이어서 이야기해요.","response":"저도 기억하고 있어요. 다음에 시간 될 때 이어가요."},
            {"text":"답장이 늦었네요. 첫날 챙겨 주셔서 고마웠어요.","response":"괜찮아요. 시간 될 때 주셔도 돼요."}]

    def d1_send_night():
        who = flags.get("first_evening", "ria")
        if who == "ria":
            send_message("goodnight")
        elif who in ("seoyun","yujin","jihyun"):
            if flags.get("d1_private_met"):
                send_message("d1_"+who+"_night")
            else:
                token = "d1_"+who+"_night:rest"
                if not any(m.get("id") == token for m in phone_messages):
                    phone_messages.append({"who":who,"out":False,"text":"오늘은 푹 쉬세요. 못 나눈 이야기는 다음에 이어가요. 첫날 수고하셨어요.","time":"21:10","day":day,"id":token})
                    phone_unread[who] = phone_unread.get(who,0)+1
        if who in names:
            store.phone_focus = who

label d1_evening_choose:
    $ chapter = "회사 밖의 연락"
    $ slot = "evening"
    $ clock = "18:50"
    "퇴근길에 잠깐 누군가와 더 이야기하고 싶었다. 점심을 같이 먹은 사람이어도, 다른 사람이어도 좋다."
    menu:
        "서윤에게 퇴근 후 시간을 물어본다.":
            $ flags["first_evening"] = "seoyun"
        "리아에게 퇴근 후 시간을 물어본다.":
            jump d1_evening_gate
        "유진에게 퇴근 후 시간을 물어본다.":
            $ flags["first_evening"] = "yujin"
        "지현에게 퇴근 후 시간을 물어본다.":
            $ flags["first_evening"] = "jihyun"
        "오늘은 연락하지 않고 집에서 쉰다.":
            $ flags["first_evening"] = "rest"
            jump d1_home
    jump d1_other_evening_gate

label d1_other_evening_gate:
    $ clock = "19:00"
    $ place = "모멘트웍스 · 엘리베이터"
    $ ui_scene_show("elevator")
    $ d1_evening_who = flags["first_evening"]
    $ phone_messages.append({"who":d1_evening_who,"out":True,"text":"퇴근하셨어요? 시간 괜찮으시면 잠깐 이야기할까요?","time":"18:50","day":day})
    $ send_message("d1_"+d1_evening_who+"_evening")
    $ ring_who = d1_evening_who
    $ phone_focus = d1_evening_who
    $ ring_pending = True
    "보낸 문자에 답이 도착하고 전화가 걸려 왔다. 지금 받거나 다음에 이야기해도 된다."
    $ renpy.retain_after_load()
    call screen phone(mode="evening",initial_contact=d1_evening_who)
    $ ring_pending = False
    if _return != "accept":
        $ phone_calls.append("DAY 01 / 19:00 / "+names[d1_evening_who]+" / 부재중")
        menu:
            "다시 전화한다.":
                jump d1_other_phone_call
            "오늘은 쉰다고 문자를 보낸다.":
                $ phone_messages.append({"who":d1_evening_who,"out":True,"text":"오늘은 집에서 쉬려고 해요. 다음에 이어서 이야기해요.","time":clock,"day":day})
                jump d1_home
    jump d1_other_phone_call

label d1_other_phone_call:
    $ ui_phone_call_begin(d1_evening_who,"d1_home")
    $ phone_calls.append("DAY 01 / 19:00 / "+names[d1_evening_who]+" / 통화 완료")
    if d1_evening_who == "seoyun":
        sy "도현 씨, 지금 잠깐 괜찮아요? 저는 회사 앞 카페에 들렀어요."
        sy "오늘 안내서를 너무 오래 보여 드렸나 싶었어요. 듣느라 피곤하셨죠?"
        dh "기억하라고 재촉하지 않으셔서 오히려 편했습니다."
        sy "다행이네요. 오늘은 설명 말고 제 차가 식기 전에 마시려고요."
        sy "한 잔 같이 하실래요? 오늘은 업무 화면 안 여는 걸로요."
    elif d1_evening_who == "yujin":
        yj "지금 통화 괜찮으세요? 저는 카페에 있어요."
        yj "오늘 처음 보는 순서를 이야기해 주신 게 도움이 됐어요. 제 눈엔 이미 익숙한 화면이라서요."
        dh "그럼 내일은 제가 익숙해진 순서도 한번 봐 주세요."
        yj "좋아요. 오늘은 잠깐 다른 걸 보고 싶네요. 제가 자주 걷는 골목 지도요."
        yj "시간 괜찮으시면 같이 볼래요? 지금 찾아가자는 건 아니고요."
    else:
        jh "도현 씨, 지금 이야기해도 괜찮아요? 회사 밖이니 급한 연락은 아닙니다."
        jh "오전에 쉬는 시간도 비워 두자고 이야기했었죠. 오늘은 저도 잠깐 멈췄어요."
        dh "점심 칸을 먼저 비워 둔다고 하셨죠. 퇴근 뒤에도 연습하시는 건가요?"
        jh "네. 저는 잠깐 카페에 앉았어요. 산책 전에 여기서 쉬고 있습니다."
        jh "들를 생각 있으시면 같이 한 잔 해요. 내일 할 질문을 받으려는 건 아니에요."
    menu:
        "잠깐 카페에 들러 이야기를 이어간다.":
            $ ui_phone_call_end()
            jump d1_other_cafe
        "오늘은 집에서 쉬고 다음에 이야기한다.":
            jump d1_home

label d1_other_cafe:
    $ flags["d1_private_met"] = True
    $ chapter = "업무 밖의 한 잔"
    $ place = "회사 앞 · 카페"
    $ clock = "19:20"
    $ ui_scene_show("cafe")
    $ complete_week_event("d1_evening",effects={"sensitivity":3,"stress":-8})
    "카페 문을 열자 회사에서 듣던 목소리가 조금 다른 거리에서 들렸다. 테이블 위에는 업무 자료가 없었다."
    if d1_evening_who == "seoyun":
        call d1_seoyun_cafe
    elif d1_evening_who == "yujin":
        call d1_yujin_cafe
    else:
        call d1_jihyun_cafe
    jump d1_other_ending

label d1_other_ending:
    $ clock = "21:30"
    $ chapter = "첫날의 기록"
    $ place = "도현의 집"
    $ ui_scene_show("home")
    $ d1_send_night()
    "집에 돌아와 오전에 적었던 네 사람의 이름을 다시 봤다. 직무 옆에 업무 밖에서 나눈 말도 조금 남아 있었다."
    "한 사람과 더 오래 이야기했다고 다른 사람의 문이 닫힌 것은 아니다. 내일 회사에서는 또 다른 질문을 할 수 있다."
    $ queue_photo_rewards()
    $ renpy.retain_after_load()
    call screen day_result
    if _return == "continue":
        jump day02
    return

label d1_team_round:
    $ clock = "09:20"
    "서윤이 안내서를 접어 책상 옆에 놓았다. 화면 안의 조직도보다 직접 걸어 보는 편이 빠르다고 했다."
    sy "제일 먼저 알려 드릴 곳은 회의실이 아니라 물 마시는 곳이에요. 길 헤매다 목마르면 더 긴장되니까요."
    dh "벌써 어떻게 보이는지 들킨 것 같네요."
    sy "새로 온 분들이 안내서보다 오래 보는 표정이 있거든요. 모르는 건 하나씩 물어보세요."
    "서윤은 비품장과 라운지까지 걸음을 맞춰 주었다. 내가 메모하는 동안에는 다음 설명을 시작하지 않았다."
    dh "메모가 느려도 기다려 주시네요."
    sy "설명은 한 번에 끝내는 게 목표가 아니에요. 나중에 도현 씨가 혼자 찾을 수 있으면 되죠."
    dh "그럼 안내서에 없는 질문 하나 해도 될까요? 점심에 덜 붐비는 곳은 어디예요?"
    sy "라운지 안쪽이요. 메뉴는 몰라도 자리는 자신 있게 추천할 수 있어요."
    "안내서 모서리에 작은 책갈피가 꽂혀 있었다. 업무 자료도 책처럼 읽는 사람일까 싶었다."
    sy "이건 안내서 책갈피가 아니라 제 소설에서 빠진 거예요. 회사까지 따라왔네요."
    dh "책갈피도 출근했군요."
    sy "저보다 제시간에 왔어요. 저는 아침에 한참 찾았거든요."
    "자리로 돌아오니 유진이 모니터 앞의 빈 의자를 조금 빼 놓았다. 같은 문장이 두 화면에서 다른 위치에 놓여 있었다."
    yj "아직 뭘 고르실 필요는 없어요. 처음 보는 사람 눈에는 어디부터 읽히는지만 알려 주세요."
    dh "이쪽은 그림부터 보고, 저쪽은 버튼부터 봤습니다."
    yj "제가 오래 보면 둘 다 외워 버려서, 처음 보는 순서를 놓치거든요."
    dh "제가 놓친 곳도 적으면 도움이 될까요?"
    yj "네. 모른다는 반응도 자료예요. 설명 듣고 알아낸 걸 처음부터 알았던 것처럼 쓰지는 말아 주세요."
    "유진이 내 시선이 멈춘 곳을 작은 표시로 남겼다. 맞는 답을 기다리는 대신 내가 본 순서를 듣고 있었다."
    dh "이 여백은 일부러 남기신 거예요?"
    yj "네. 다 채우면 어디서 쉬어야 하는지 모르니까요. 화면도 사람도요."
    dh "오늘 일정에도 여백이 조금 있었으면 좋겠네요."
    yj "첫날은 있죠. 방금 서윤 씨가 잡아 준 설명 시간도 그중 하나예요."
    "유진이 종이를 맞추다 한 장은 그대로 두었다. 시험 삼아 인쇄한 색이 마음에 든다고 했다."
    yj "버리기 아까운 건 늘 마지막에 한 장 남아요. 책상은 그래서 잘 안 비워지고요."
    "지현은 회의실 대신 작은 테이블을 골랐다. 노트북을 펼치기 전에 오늘 일정부터 짧게 확인했다."
    jh "여섯 주 일정표를 보셨죠. 오늘 안에 여섯 주를 이해할 필요는 없습니다."
    dh "빨리 따라잡아야 할 것 같아서 모르는 것도 일단 적고 있었습니다."
    jh "적는 건 좋아요. 다만 질문이 없어 보이려고 지우지는 마세요. 모르는 부분을 알아야 제가 설명할 수 있으니까요."
    dh "회의에서 바로 물어봐도 되는 건가요?"
    jh "네. 대답에 시간이 필요하면 제가 그렇게 말하겠습니다. 질문하는 사람이 먼저 사과할 일은 아니에요."
    "지현은 일정표에서 점심 시간을 손끝으로 짚었다. 그 칸에는 업무 제목이 없었다."
    dh "점심도 회의로 채울 수 있을 줄 알았는데요."
    jh "가끔 그러고 싶어지죠. 그래서 먼저 비워 둡니다. 제가 잊으면 도현 씨도 알려 주세요."
    dh "팀장님 일정에 처음부터 의견을 내도 되나요?"
    jh "시간이 안 된다는 말은 의견이 아니라 필요한 정보예요. 제가 놓칠 때도 있고요."
    "말끝은 단정했지만, 내가 의자를 당기자 자기 자료도 비켜 주었다. 질문할 자리가 실제로 남아 있었다."
    jh "첫날에 한 가지를 정리해 왔다면 충분합니다. 나머지는 같이 보고요."
    $ clock = "10:20"
    return

label d1_before_leaving:
    $ clock = "18:10"
    "자리마다 퇴근 준비하는 소리가 났다. 오전에는 이름과 직무였던 사람들이 조금씩 다른 모습으로 기억되기 시작했다."
    sy "도현 씨, 안내서는 책상에 두고 가도 돼요. 집에서 예습하실 필요는 없어요."
    dh "오늘 배운 길은 내일 혼자 찾아 보겠습니다."
    sy "막히면 다시 물어봐요. 길도 일도 첫날 한 번에 외우는 게 능력은 아니니까."
    "유진은 종이를 폴더에 넣고 책상 모서리의 작은 얼룩을 손끝으로 닦았다."
    yj "내일은 도현 씨가 어디서 멈췄는지부터 다시 볼게요. 오늘 표시한 건 지우지 않을게요."
    dh "틀린 답처럼 남는 줄 알았는데, 시작점이 되는 거네요."
    yj "네. 내일 다시 봤을 때 다르게 읽히는지도 궁금해요."
    "지현은 회의실 문을 닫고 내 빈 노트 한쪽을 바라봤다."
    jh "질문이 남았으면 내일 가져오세요. 오늘 안에 답을 다 받지 않아도 됩니다."
    dh "한 장이면 충분하다고 하셨죠. 다음 장은 내일 쓰겠습니다."
    jh "좋아요. 오늘은 페이지를 덮는 쪽부터 연습하죠."
    "컴퓨터 화면이 하나둘 꺼졌다. 회사 밖에서 이어갈 이야기와 내일로 남길 이야기를 내가 고를 수 있다."
    return

label d1_other_lunch:
